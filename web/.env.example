# Clerk — auth only. No Clerk-to-Supabase token setup.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase — server-only. The service key bypasses RLS and must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase values: used only for the signed upload of the screenshot. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenRouter — vision checks on submitted screenshots.
OPENROUTER_API_KEY=

# The Heat 001 Luma event. Until it's set, the main button goes to /post.
NEXT_PUBLIC_LUMA_URL=
# The Luma event id (evt-…) for the in-page RSVP box. Leave empty to hide the box.
NEXT_PUBLIC_LUMA_EVENT_ID=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
