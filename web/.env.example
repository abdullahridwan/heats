# Clerk — leave empty in local dev to use Clerk keyless mode (temporary keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase — without these the site runs read-only on the seeded season
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Comma-separated Clerk user ids allowed into /admin
ADMIN_USER_IDS=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
