# Supabase. The service key bypasses RLS and must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase values: used by the browser for auth and the signed screenshot upload. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenRouter: vision checks on submitted screenshots.
OPENROUTER_API_KEY=

# Password for the /admin page. Use a long random value.
ADMIN_PASSWORD=
# Secret that signs the admin session cookie. Use a long random value, different from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
